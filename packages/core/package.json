{
  "name": "@solo/core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0ctacity/solo"
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solo/native": "workspace:^",
    "eventsource-parser": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
