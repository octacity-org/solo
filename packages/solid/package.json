{
  "name": "@solo/solid",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "solo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js",
      "default": "./dist/automation.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./_native": {
      "types": "./dist/_native.d.ts",
      "import": "./dist/_native.js",
      "default": "./dist/_native.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0ctacity/solo"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @solo/solid locally. There is no automated release path; see AGENTS.md.'); process.exit(1) }\"",
    "build": "rm -rf dist *.tsbuildinfo && tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/core": "^7",
    "@solo/core": "workspace:^",
    "@solo/native": "workspace:^",
    "@solidjs/universal": "2.0.0-rc.15",
    "@solidjs/babel-plugin": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.3.3",
    "typescript": "^5.3.0",
    "vite": "^7",
    "vitest": "^4.0.18"
  }
}
