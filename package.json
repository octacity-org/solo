{
  "name": "solo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/solid-counter",
    "examples/tasks",
    "examples/webview-preview"
  ],
  "scripts": {
    "build": "bun run build:native && bun run build:core && bun run build:solid",
    "build:native": "cd packages/native && bun run build",
    "build:core": "cd packages/core && bun run build",
    "build:solid": "cd packages/solid && bun run build",
    "dev": "bun scripts/dev.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {},
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.15"
  }
}
